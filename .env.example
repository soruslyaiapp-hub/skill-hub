# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Public URL of the site (no trailing slash). On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://skillhub.example.com

# GitHub repo as owner/name. Turns on "Suggest an edit", the Submit page and the GitHub links.
NEXT_PUBLIC_GITHUB_REPO=your-github-name/skill-hub

# Analytics (optional, pick one)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# Used by `npm run sync:github` locally (optional; raises the limit from 60 to 5,000 requests per hour)
GITHUB_TOKEN=
